# 生产基础设施的凭据。复制成 docker/.env（已在 .gitignore 里，权限设成 600）再填值；
# deploy.sh 没有这个文件就拒绝启动。不要把真实值提交进仓库，也不要写进变更文档。
#
# 生成密码：openssl rand -hex 24（只含 0-9a-f，放进 YAML、plist、URL 都不用转义）。
#
# 注意：MYSQL_ROOT_PASSWORD、RABBITMQ_USER/PASSWORD 只在【第一次初始化】时生效：MySQL 是数据卷为空时，
# RabbitMQ 是 broker 数据目录为空时（给 rabbitmq 加上固定 hostname 后的第一次重建也算一次）。
# 已有数据的环境改密码，要按 docs/config-changes/2026-10-04-p0-hardening.md 的步骤做，只改这里不会改掉已有的密码。
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# 内存上限（可选）。不设 = 不限，和以前一样。跑满一天后按变更文档第 5 节量出峰值再设，例如 MYSQL_MEMORY=1g；
# 改了之后执行 ./deploy.sh infra 才生效，对应的容器会重建，要放在维护窗口里做。
NACOS_MEMORY=
MYSQL_MEMORY=
REDIS_MEMORY=
RABBITMQ_MEMORY=
MINIO_MEMORY=
ELASTICSEARCH_MEMORY=
FILEBEAT_MEMORY=
KIBANA_MEMORY=
